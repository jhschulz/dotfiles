configuration {
  display-drun: "Applications";
  display-window: "Windows";
  drun-display-format: "{icon} {name}";
  show-icons: true;
  icon-theme: "Papirus";
  modi: "window,drun,ssh,combi";
  font: "hack 10";
  combi-modi: "window,drun,ssh";
}

@theme "/usr/share/rofi/themes/gruvbox-dark.rasi"
